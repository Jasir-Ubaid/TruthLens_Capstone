MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=truthlens_db

# File storage directories
UPLOAD_DIR=./uploads
STATIC_DIR=./static
HEATMAP_DIR=./static/heatmaps

# Server settings
HOST=0.0.0.0
PORT=8000
DEBUG=True
